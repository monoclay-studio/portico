{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/modules/*/src/**",
        "$TURBO_ROOT$/modules/*/migrations/**",
        "$TURBO_ROOT$/modules/*/package.json",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/modules/*/src/**",
        "$TURBO_ROOT$/modules/*/migrations/**",
        "$TURBO_ROOT$/modules/*/package.json",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": [],
      "env": ["DATABASE_URL", "PORTICO_TEST_DB_PREFIX"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
