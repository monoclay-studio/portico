{
  "name": "portico",
  "private": true,
  "description": "Portico — cloud hospitality management platform by Monoclay",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=2",
    "lint": "biome check .",
    "format": "biome format --write .",
    "migrate": "pnpm --filter @portico/api migrate",
    "db:up": "bash tools/db-up.sh",
    "dev:api": "pnpm --filter @portico/api dev",
    "dev:worker": "pnpm --filter @portico/worker dev",
    "dev:backoffice": "pnpm --filter @portico/backoffice dev",
    "seed:demo": "pnpm --filter @portico/api seed:demo"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
