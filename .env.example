# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/portico_dev
# Role used by the running application (RLS applies to it). Created by migrations.
APP_DATABASE_URL=postgres://portico_app:portico_app_dev@127.0.0.1:5432/portico_dev
PORT=4000
LOG_LEVEL=info
# 32-byte base64 key for field-level encryption in development only. Production uses AWS KMS.
PORTICO_DEV_DATA_KEY=ZGV2LW9ubHktZGF0YS1rZXktZG8tbm90LXVzZS0xMjM0
# Payments: 'simulator' (default) or 'stripe'
PAYMENTS_PROVIDER=simulator
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
