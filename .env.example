# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/portico_dev
# Role used by the running application (RLS applies to it). Created by migrations.
APP_DATABASE_URL=postgres://portico_app:portico_app_dev@127.0.0.1:5432/portico_dev
PORT=4000
LOG_LEVEL=info
# Field encryption + blind-index keys (base64). Leave unset locally to use labelled development keys.
# Deployed environments MUST set both (distinct values, from AWS Secrets Manager); production refuses dev keys.
PORTICO_FIELD_KEY=
PORTICO_BLIND_INDEX_KEY=
PORTICO_FIELD_KEY_ID=
# Payments: 'simulator' (default) or 'stripe'
PAYMENTS_PROVIDER=simulator
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
