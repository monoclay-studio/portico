# Portico deploy pipeline — EXAMPLE, NOT ACTIVE.
#
# Copy to .github/workflows/deploy.yml only after the owner authorizes AWS spend (OPEN_QUESTIONS Q4/Q22) and the cells
# exist (docs/runbooks/deploy.md § First-time setup). Until then this file deploys nothing.
#
# Flow: verify (lint, typecheck, tests against Postgres 16) → build the api/worker images ONCE (OCI archives, arm64)
# and the staff web app → per cell: push the same bytes (digests preserved) → infra/ci/deploy-cell.sh:
# [role bootstrap] → migrations → routing grants → worker → api → smoke test → automatic rollback on failure →
# publish the web app. The script is tested offline: infra/ci/test/deploy-cell.test.sh.
#
# Security:
#   - No long-lived AWS keys. Each job assumes its cell's deploy role through GitHub OIDC; the role trusts only this
#     repository AND the job's GitHub Environment (modules/ci-deploy-role). The role can push images, register task
#     definitions, run the one-off tasks, update the two services and publish the web app — not change
#     infrastructure (Terraform is applied by a person, docs/runbooks/deploy.md).
#   - GitHub Environments `demo`, `staging`, `production`; `production` has required reviewers (the owner) and a
#     wait timer. Environment variables (not secrets — none are needed): AWS_DEPLOY_ROLE_ARN, AWS_REGION, CELL_PREFIX.
#   - Every third-party action is pinned to a full commit SHA (resolved 2026-11-07 with `git ls-remote`; tag dates
#     checked to be at least two weeks old). Dependabot/renovate should propose updates.
#   - permissions default to read; only deploy jobs get id-token: write.
#
# Not verified here: this file was parsed (YAML) and its deploy script tested against a fake AWS CLI, but it has
# never run on GitHub. The three deploy jobs share their steps through a YAML anchor (&deploy_steps); GitHub
# Actions accepts anchors since 2025 — if your tooling does not, copy the steps into each job.

name: deploy

on:
  workflow_dispatch:
    inputs:
      target:
        description: Where to deploy this commit
        type: choice
        options: [demo, staging, production, staging-then-production]
        default: staging-then-production
      bootstrap_roles:
        description: Run the database role bootstrap first (first deploy of a cell; after a credential rotation)
        type: boolean
        default: false
  push:
    branches: [main] # main deploys to the demo cell only

permissions:
  contents: read

env:
  NODE_VERSION: "22"

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres" --health-interval 5s --health-timeout 5s --health-retries 20
    env:
      DATABASE_URL: postgres://postgres@127.0.0.1:5432/postgres
      PORTICO_TEST_DB_PREFIX: ci_${{ github.run_id }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0 (version from package.json "packageManager")
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm lint
      - run: pnpm typecheck
      - run: pnpm test
      - name: Deploy script control flow (offline, fake AWS)
        run: infra/ci/test/deploy-cell.test.sh

  build:
    needs: verify
    # Native arm64 runner: images run on Graviton (Fargate ARM64 / t4g). Without arm64 runners, add
    # docker/setup-qemu-action and build with --platform linux/arm64 on ubuntu-24.04 (slower).
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 45
    outputs:
      tag: ${{ steps.meta.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: meta
        run: echo "tag=${GITHUB_SHA}" >>"$GITHUB_OUTPUT"
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
      - name: Build api and worker images once (OCI archives; digests travel with them)
        run: |
          set -euo pipefail
          mkdir -p oci
          for app in api worker; do
            docker buildx build --platform linux/arm64 -f "apps/$app/Dockerfile" \
              --build-arg GIT_SHA="$GITHUB_SHA" --provenance=mode=max --sbom=true \
              --output "type=oci,dest=oci/$app.oci.tar" .
          done
          ls -l oci
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm
      - name: Build the staff web app (same-origin API through CloudFront; no API base URL needed)
        run: pnpm install --frozen-lockfile && pnpm --filter @portico/backoffice build
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: release-${{ github.sha }}
          path: |
            oci/
            apps/backoffice/dist/
          retention-days: 30
          if-no-files-found: error

  deploy-demo:
    needs: build
    if: github.event_name == 'push' || inputs.target == 'demo'
    environment: demo
    concurrency: { group: deploy-demo, cancel-in-progress: false }
    permissions: { contents: read, id-token: write }
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps: &deploy_steps
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-${{ github.sha }}
          path: release
      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
          role-session-name: deploy-${{ github.run_id }}
      - name: Ensure skopeo (digest-preserving image copy)
        run: command -v skopeo || (sudo apt-get update -q && sudo apt-get install -y -q skopeo)
      - name: Deploy (push → [bootstrap] → migrate → grants → worker → api → smoke → rollback on failure → web)
        run: |
          set -euo pipefail
          args=(--push-oci release/oci --web-dist release/apps/backoffice/dist)
          if [ "${{ inputs.bootstrap_roles }}" = "true" ]; then args+=(--bootstrap-roles); fi
          infra/ci/deploy-cell.sh "${{ vars.CELL_PREFIX }}" "${{ needs.build.outputs.tag }}" "${args[@]}"

  deploy-staging:
    needs: build
    if: inputs.target == 'staging' || inputs.target == 'staging-then-production'
    environment: staging
    concurrency: { group: deploy-staging, cancel-in-progress: false }
    permissions: { contents: read, id-token: write }
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps: *deploy_steps

  deploy-production:
    needs: [build, deploy-staging]
    # Production only ever receives what staging just ran successfully, unless the owner deploys production alone
    # (target = production; e.g. an urgent fix while staging is switched off) — then the reviewers decide.
    if: >-
      always() && needs.build.result == 'success' &&
      (inputs.target == 'production' ||
       (inputs.target == 'staging-then-production' && needs.deploy-staging.result == 'success'))
    environment: production
    concurrency: { group: deploy-production, cancel-in-progress: false }
    permissions: { contents: read, id-token: write }
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps: *deploy_steps
