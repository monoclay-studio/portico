# Copy to backend.hcl (git-ignored) and run: terraform init -backend-config=backend.hcl
bucket         = "portico-tfstate-<account id>"
key            = "portico/production/aps1-c01/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "portico-terraform-locks"
kms_key_id     = "alias/portico-terraform-state"
encrypt        = true
