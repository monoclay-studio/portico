{
  "source": ["aws.ecs"],
  "detail-type": ["ECS Task State Change"],
  "detail": {
    "lastStatus": ["STOPPED"],
    "taskDefinitionArn": [{ "prefix": "${family_arn_prefix}" }],
    "$or": [
      { "stopCode": ["TaskFailedToStart"] },
      { "containers": { "exitCode": [{ "anything-but": 0 }] } },
      { "containers": { "exitCode": [{ "exists": false }] } }
    ]
  }
}
