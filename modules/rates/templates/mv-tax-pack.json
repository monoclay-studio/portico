            "ratePercent": "6",
            "appliesTo": {
              "taxCategories": [
                "accommodation",
                "food_beverage",
                "transfer",
                "spa",
                "activity",
                "retail",
                "other_service"
              ],
              "outletKinds": ["general_sector"]
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
