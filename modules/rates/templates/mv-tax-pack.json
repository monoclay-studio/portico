          },
          "sources": [
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/newsgstratechange",
              "title": "MIRA — GST rate changes from 1 January 2023",
              "retrievedOn": "2026-11-07"
            }
          ]
        },
        {
          "effectiveFrom": "2023-01-01",
          "effectiveTo": null,
          "definition": {
            "kind": "percentage",
            "ratePercent": "8",
            "appliesTo": {
              "taxCategories": [
                "accommodation",
                "food_beverage",
                "transfer",
                "spa",
                "activity",
                "retail",
                "other_service"
              ],
              "outletKinds": ["general_sector"]
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
            "note": "General-sector GST 8% from 2023-01-01 (MIRA). Applies only to outlets explicitly registered in the general sector (outlet kind 'general_sector'); outlets inside tourist premises default to the tourism sector. Not legal advice — adviser to confirm (Q20)."
          },
          "sources": [
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/newsgstratechange",
              "title": "MIRA — GST rate changes from 1 January 2023",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://mira.gov.mv/Pages/View/gst",
              "title": "MIRA — GST overview",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://www.mira.gov.mv/Pages/View/FAQ_GST",
              "title": "MIRA — GST FAQ (sector registration)",
              "retrievedOn": "2026-11-07"
            }
          ]
        }
      ],
      "nature": "statutory"
    },
    {
      "code": "MV-GREEN-12",
      "name": "Green Tax (USD 12 per guest per day)",
      "category": "tax",
      "taxPointPolicy": "service_date",
      "ledgerMappingKey": "tax.green_tax",
      "sequence": 30,
      "versions": [
        {
          "effectiveFrom": "2025-01-01",
          "effectiveTo": null,
          "definition": {
            "kind": "per_person_night",
            "amount": {
              "value": "12.00",
              "currency": "USD"
            },
            "appliesTo": {
              "taxCategories": ["accommodation"],
              "classification": {
                "all": [
                  {
                    "key": "mv.establishmentType",
                    "in": ["resort", "integrated_resort", "resort_hotel", "hotel", "guesthouse", "vessel"]
                  }
                ],
                "any": [
                  {
                    "key": "mv.establishmentType",
                    "in": ["resort", "integrated_resort", "resort_hotel", "vessel"]
                  },
                  {
                    "key": "mv.inhabitedIsland",
                    "equals": false
                  },
                  {
                    "key": "mv.registeredRooms",
                    "min": 51
                  }
                ]
              }
            },
            "persons": {
              "exemptChildrenUnderAge": 2
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
            "note": "USD 12 per guest per day from 2025-01-01 for resorts, integrated resorts, resort hotels, hotels, guesthouses and tourist vessels, except hotels/guesthouses on inhabited islands with ≤ 50 registered rooms (MV-GREEN-6). Children under 2 at check-in exempt; complimentary stays still taxable. Not legal advice — adviser to confirm (Q20)."
          },
          "sources": [
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/circular-re-changes-to-grt-rates-on-20250101-news",
              "title": "MIRA — circular on Green Tax rates from 1 Jan 2025",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://www.mira.gov.mv/Legislations/View/14-th-amendment-to%20the-tourism-act",
              "title": "MIRA — 14th amendment to the Tourism Act",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://mira.gov.mv/Pages/View/FAQ_GreenTax",
              "title": "MIRA — Green Tax FAQ",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://mira.gov.mv/Legislations/View/Green-tax-regulation",
              "title": "MIRA — Green Tax Regulation (consolidated)",
              "retrievedOn": "2026-11-07"
            }
          ],
          "notes": "Charged per guest per 24-hour block; the check-out block counts if 12 hours or more were spent in it (a late check-out that crosses the threshold is posted as an extra accommodation line). Must appear as its own invoice line and is outside the GST base. Paid to MIRA in USD monthly (MIRA 501)."
        }
      ],
      "nature": "statutory"
    },
    {
      "code": "MV-GREEN-6",
      "name": "Green Tax (USD 6 per guest per day — inhabited island, ≤ 50 registered rooms)",
      "category": "tax",
      "taxPointPolicy": "service_date",
      "ledgerMappingKey": "tax.green_tax",
      "sequence": 31,
      "versions": [
        {
          "effectiveFrom": "2025-01-01",
          "effectiveTo": null,
          "definition": {
            "kind": "per_person_night",
            "amount": {
              "value": "6.00",
              "currency": "USD"
            },
            "appliesTo": {
              "taxCategories": ["accommodation"],
              "classification": {
                "all": [
                  {
                    "key": "mv.establishmentType",
                    "in": ["hotel", "guesthouse"]
                  },
                  {
                    "key": "mv.inhabitedIsland",
                    "equals": true
                  },
                  {
                    "key": "mv.registeredRooms",
                    "max": 50
                  }
                ]
              }
            },
            "persons": {
              "exemptChildrenUnderAge": 2
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
            "note": "USD 6 per guest per day from 2025-01-01 for hotels and guesthouses on inhabited islands with 50 or fewer REGISTERED rooms. Children under 2 at check-in exempt; complimentary stays still taxable. Not legal advice — adviser to confirm (Q20)."
          },
          "sources": [
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/circular-re-changes-to-grt-rates-on-20250101-news",
              "title": "MIRA — circular on Green Tax rates from 1 Jan 2025",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://mira.gov.mv/Pages/View/FAQ_GreenTax",
              "title": "MIRA — Green Tax FAQ",
              "retrievedOn": "2026-11-07"
            }
          ],
          "notes": "Same daily-block, separate-line and non-GST-base treatment as MV-GREEN-12."
        }
      ],
      "nature": "statutory"
    }
