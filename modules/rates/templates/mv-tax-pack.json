{
  "template": "MV",
  "templateVersion": "2026-11-07",
  "jurisdiction": "MV",
  "basedOn": "docs/readiness/maldives-tax-rules.md (researched 2026-11-07 from MIRA / Ministry of Tourism pages)",
  "disclaimer": "Working reference, not legal or tax advice. A Maldives tax adviser must confirm before any live invoice is issued (OPEN_QUESTIONS Q20, Q41, Q42).",
  "rules": [
    {
      "code": "MV-SC",
      "name": "Service charge",
      "category": "fee",
      "taxPointPolicy": "service_date",
      "ledgerMappingKey": "fee.service_charge",
      "sequence": 10,
      "versions": [
        {
          "effectiveFrom": null,
          "effectiveTo": null,
          "definition": {
            "kind": "percentage",
            "ratePercent": "10",
            "appliesTo": {
              "taxCategories": ["accommodation", "food_beverage"]
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "unverified",
            "note": "Tourism businesses must levy at least 10% (news sources; Labour Relations Authority regulation not read directly). The hotel sets its own rate and the charge categories it applies to. That service charge is part of the GST taxable value IS verified (GST Regulation) and is modelled in MV-TGST's base."
          },
          "sources": [
            {
              "url": "https://atolltimes.mv/post/business/15673",
              "title": "Atoll Times — service charge reporting",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://lra.gov.mv/2021/03/",
              "title": "Labour Relations Authority — Service Charge Regulation gazetted",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://www.mira.gov.mv/Legislations/View/Goods-and-Services-Tax-Regulation-consolidated",
              "title": "MIRA — GST Regulation (consolidated): service charge in taxable value",
              "retrievedOn": "2026-11-07"
            }
          ],
          "notes": "Voluntary tips are not service charge and are outside the GST base: post them with tax category 'gratuity' (no rule applies). Confirm the rate and categories with the hotel and the adviser. Commercial rule: an agreed stay keeps the service-charge version recorded in its terms; a later change applies to new agreements and to charges outside an agreement."
        }
      ],
      "nature": "commercial"
    },
    {
      "code": "MV-TGST",
      "name": "Tourism Goods and Services Tax (TGST)",
      "category": "tax",
      "taxPointPolicy": "time_of_supply",
      "ledgerMappingKey": "tax.tgst",
      "sequence": 20,
      "versions": [
        {
          "effectiveFrom": "2014-11-01",
          "effectiveTo": "2023-01-01",
          "definition": {
            "kind": "percentage",
            "ratePercent": "12",
            "base": {
              "includeNet": true,
              "includeRuleCodes": ["MV-SC"]
            },
            "appliesTo": {
              "taxCategories": [
                "accommodation",
                "food_beverage",
                "transfer",
                "spa",
                "activity",
                "retail",
                "other_service"
              ],
              "excludeOutletKinds": ["general_sector"]
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
            "note": "12% for supplies with time of supply 2014-11-01 to 2022-12-31 (MIRA news item on the 6th amendment); same 24-hour-operator midnight rule. Not legal advice — adviser to confirm (Q20)."
          },
          "sources": [
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/newsgstratechange",
              "title": "MIRA — GST rate changes from 1 January 2023",
              "retrievedOn": "2026-11-07"
            }
          ],
          "notes": "Tax point = time of supply (earlier of invoice issue or payment). Supplies before 2014-11-01 are not covered by this pack."
        },
        {
          "effectiveFrom": "2023-01-01",
          "effectiveTo": "2025-07-01",
          "definition": {
            "kind": "percentage",
            "ratePercent": "16",
            "base": {
              "includeNet": true,
              "includeRuleCodes": ["MV-SC"]
            },
            "appliesTo": {
              "taxCategories": [
                "accommodation",
                "food_beverage",
                "transfer",
                "spa",
                "activity",
                "retail",
                "other_service"
              ],
              "excludeOutletKinds": ["general_sector"]
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
            "note": "16% for supplies with time of supply 2023-01-01 to 2025-06-30 (MIRA). Not legal advice — adviser to confirm (Q20)."
          },
          "sources": [
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/newsgstratechange",
              "title": "MIRA — GST rate changes from 1 January 2023",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://mira.gov.mv/Pages/View/gst",
              "title": "MIRA — GST overview",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/circular-issued-changes-to-tgst-rate",
              "title": "MIRA — circular on the TGST rate change",
              "retrievedOn": "2026-11-07"
            }
          ],
          "notes": "A deposit received before 2025-07-01 fixed TGST at 16% for that part (ChargeLine.taxPointSplits)."
        },
        {
          "effectiveFrom": "2025-07-01",
          "effectiveTo": null,
          "definition": {
            "kind": "percentage",
            "ratePercent": "17",
            "base": {
              "includeNet": true,
              "includeRuleCodes": ["MV-SC"]
            },
            "appliesTo": {
              "taxCategories": [
                "accommodation",
                "food_beverage",
                "transfer",
                "spa",
                "activity",
                "retail",
                "other_service"
              ],
              "excludeOutletKinds": ["general_sector"]
            },
            "inclusiveDefault": false,
            "rounding": {
              "mode": "half_up",
              "scope": "per_line"
            }
          },
          "verification": {
            "status": "verified_official_source",
            "note": "17% for supplies with time of supply on/after 2025-07-01 (MIRA page + circular). Service charge is in the base; Green Tax is NOT (GST is not charged on Green Tax). Per-line half-up rounding is Portico's default, not a MIRA rule. Not legal advice — adviser to confirm (Q20)."
          },
          "sources": [
            {
              "url": "https://mira.gov.mv/Pages/View/gst",
              "title": "MIRA — GST overview",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://www.mira.gov.mv/ContentItems/View/circular-issued-changes-to-tgst-rate",
              "title": "MIRA — circular on the TGST rate change",
              "retrievedOn": "2026-11-07"
            },
            {
              "url": "https://www.mira.gov.mv/Legislations/View/Goods-and-Services-Tax-Regulation-consolidated",
              "title": "MIRA — GST Regulation (consolidated)",
              "retrievedOn": "2026-11-07"
            }
          ],
          "notes": "Tourism-sector tax is reported and paid in USD; a non-USD invoice must record a USD conversion within ±2% of the MMA rate for the time of supply (finance records rate, source and date)."
        }
      ],
      "nature": "statutory"
    },
    {
      "code": "MV-GST-GENERAL",
      "name": "General-sector GST",
      "category": "tax",
      "taxPointPolicy": "time_of_supply",
      "ledgerMappingKey": "tax.gst_general",
      "sequence": 21,
      "versions": [
        {
          "effectiveFrom": "2014-11-01",
          "effectiveTo": "2023-01-01",
          "definition": {
